# Reachable HTTPS origin, without /api/v1. Never put credentials here.
EXPO_PUBLIC_API_URL=https://your-suraksha-api.example.com
EXPO_PUBLIC_OIDC_ISSUER=
EXPO_PUBLIC_OIDC_CLIENT_ID=
# Optional uncompressed P-256 public-key hex pin; not a secret.
EXPO_PUBLIC_DEVICE_CA_PUBLIC_KEY=
# Local testing only. Keep false in production builds.
EXPO_PUBLIC_ENABLE_TEST_LOGIN=false
EXPO_PUBLIC_ALLOW_INSECURE_HTTP=false
