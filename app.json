{
  "expo": {
    "name": "Suraksha",
    "slug": "suraksha-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "suraksha",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.suraksha.emergency",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Suraksha uses Bluetooth to relay emergency SOS messages to nearby phones when you have no internet connection.",
        "NSBluetoothPeripheralUsageDescription": "Suraksha uses Bluetooth to broadcast emergency SOS alerts to nearby devices.",
        "NSLocationWhenInUseUsageDescription": "Suraksha needs your location to send accurate emergency coordinates with your SOS alert.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "bluetooth-peripheral"
        ]
      }
    },
    "android": {
      "package": "com.suraksha.emergency",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_ADVERTISE",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-secure-store",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74126eea-90fe-412f-99ab-54e79cbaac7c"
      }
    }
  }
}
